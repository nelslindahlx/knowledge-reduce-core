[Unit]
Description=KnowledgeReduce Real-Time Ingestion Watcher Daemon
After=network.target

[Service]
Type=simple
User=<your-user>
WorkingDirectory=%h
ExecStart=/usr/local/bin/knowledgereduce watch-daemon --dir %h/knowledgereduce_watch --store %h/knowledgereduce_store --db-log %h/knowledgereduce_watcher.db
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
