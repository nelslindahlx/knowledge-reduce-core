<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.knowledgereduce.watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/knowledgereduce</string>
        <string>watch-daemon</string>
        <string>--dir</string>
        <string>/path/to/knowledgereduce_watch</string>
        <string>--store</string>
        <string>/path/to/knowledgereduce_store</string>
        <string>--db-log</string>
        <string>/path/to/knowledgereduce_watcher.db</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/path/to/knowledgereduce_watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/knowledgereduce_watcher.log</string>
</dict>
</plist>
