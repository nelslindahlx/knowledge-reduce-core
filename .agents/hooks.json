{
  "anti-oscillation-pre-pr-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-sync --directory .. python scripts/hooks/pre_pr_safety_gate.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
